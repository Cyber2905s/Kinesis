# Postgres is the source of truth.
DATABASE_URL=postgres://kinesis:kinesis@localhost:5432/kinesis?sslmode=disable
DB_MAX_CONNS=32
# Broker for ledger events (Redis Streams).
REDIS_URL=redis://localhost:6379/0
OUTBOX_STREAM=ledger.events
OUTBOX_BATCH=500
OUTBOX_INTERVAL=100ms
# HTTP listener (api serves the API + dashboard, worker serves /metrics).
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
# Worker housekeeping.
RECON_INTERVAL=30s
IDEMPOTENCY_TTL=24h
# Enables POST /v1/demo/burst used by the dashboard. Keep off in production.
DEMO_ENABLED=false
